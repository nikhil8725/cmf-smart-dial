<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Unique identifier for the service -->
    <key>Label</key>
    <string>com.local.mac-trigger-service</string>

    <!-- Command and arguments to execute -->
    <key>ProgramArguments</key>
    <array>
        <!-- Replace with absolute path to your Python interpreter -->
        <string>/Users/nikhilbahalkar/Documents/antigravity/CMF-DIY/.venv/bin/python</string>
        <string>/Users/nikhilbahalkar/Documents/antigravity/CMF-DIY/main.py</string>
        <string>--config</string>
        <string>/Users/nikhilbahalkar/Documents/antigravity/CMF-DIY/config.json</string>
    </array>

    <!-- Working directory for relative paths (e.g., trigger.log, scripts/) -->
    <key>WorkingDirectory</key>
    <string>/Users/nikhilbahalkar/Documents/antigravity/CMF-DIY</string>

    <!-- Automatically start on user login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Automatically restart if terminated unexpectedly -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <!-- Set to Interactive so it runs with GUI session privileges for EventTap -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <!-- Standard log files for launchd process manager -->
    <key>StandardOutPath</key>
    <string>/Users/nikhilbahalkar/Documents/antigravity/CMF-DIY/service.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nikhilbahalkar/Documents/antigravity/CMF-DIY/service.stderr.log</string>

    <!-- Inherit user environment PATH so scripts can find homebrew and system tools -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
